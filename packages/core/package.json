{
  "name": "@overfull/core",
  "version": "3.1.1",
  "private": true,
  "description": "Browser-safe checks for LaTeX documents: build logs, references, PDF accessibility, venue rules.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
