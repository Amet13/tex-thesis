---
import Base from '../layouts/Base.astro';
import { url } from '../lib/paths';
import { clauseRuleIds } from '../lib/verapdf-clauses';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="nf galley" id="nf" data-clauses={JSON.stringify(clauseRuleIds())}>
    <p class="runhead"><span>Error 404</span></p>
    <h1>! Undefined page.</h1>
    <pre class="nf-log"><code>l.404 \input{"{"}<span class="nf-u">this-page</span>{"}"}
?</code></pre>
    <p>No page lives at this address. It may have moved when tex-thesis became Overfull.</p>
    <ul>
      <li><a href={url()}>Home</a></li>
      <li><a href={url('docs/')}>Guide</a></li>
      <li><a href={url('rules/')}>Rule index</a></li>
      <li><a href={url('check/')}>Browser check</a></li>
    </ul>
  </div>
</Base>
<script>
  // veraPDF clause ids: `/rules/verapdf-7-21-4-1/` → the nearest clause page
  // (`/rules/verapdf-7-21/`), else the generic `/rules/verapdf/`.
  const known: string[] = JSON.parse(document.getElementById('nf')?.dataset.clauses ?? '[]');
  const m = /^(.*\/rules\/)(verapdf-\d[\w-]*?)\/?$/.exec(location.pathname);
  if (m) {
    const parts = (m[2] as string).split('-');
    let target = 'verapdf';
    while (parts.length > 1) {
      if (known.includes(parts.join('-'))) {
        target = parts.join('-');
        break;
      }
      parts.pop();
    }
    location.replace(`${m[1]}${target}/`);
  }
</script>
<style>
  .nf {
    padding-block: 3rem;
  }
  h1 {
    font-family: var(--mono);
    font-size: var(--s2);
    color: var(--error);
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .nf-log {
    border-left-color: var(--pencil);
  }
  .nf-u {
    text-decoration: underline wavy var(--pencil);
  }
</style>
