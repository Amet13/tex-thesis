---
import '@fontsource/libertinus-serif/latin-400.css';
import '@fontsource/libertinus-serif/latin-400-italic.css';
import '@fontsource/libertinus-serif/latin-600.css';
import '@fontsource/libertinus-serif/latin-ext-400.css';
import '@fontsource/libertinus-sans/latin-700.css';
import '@fontsource/commit-mono/latin-400.css';
import '@fontsource/commit-mono/latin-700.css';
import '../styles/global.css';
import { REPO_URL, url } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  /** Section for the nav highlight. */
  section?: 'home' | 'docs' | 'rules' | 'check' | 'templates';
  /** Full-bleed main (no frame padding). */
  bare?: boolean;
}
const { title, description, section } = Astro.props;
const fullTitle = section === 'home' ? `Overfull — ${title}` : `${title} · Overfull`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: url('docs/'), label: 'Guide', key: 'docs' },
  { href: url('rules/'), label: 'Rules', key: 'rules' },
  { href: url('check/'), label: 'Browser check', key: 'check' },
  { href: url('templates/'), label: 'Templates', key: 'templates' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111617" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('overfull-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sheet-paper">
      <div class="frame">
        <header class="masthead">
          <a class="wordmark" href={url()} aria-label="Overfull, home">
            <span aria-hidden="true">Overfull</span><span class="wm-margin" aria-hidden="true"></span><span class="wm-slug" aria-hidden="true"></span>
          </a>
          <nav aria-label="Main">
            <ul class="nav">
              {nav.map((n) => (
                <li><a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a></li>
              ))}
              <li><a href={REPO_URL}>GitHub</a></li>
            </ul>
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
            <span data-theme-label>Dark</span><span class="sr-only"> theme</span>
          </button>
        </header>
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <footer class="colophon">
          <div>
            <h2>Overfull</h2>
            <p>A free preflight kit for LaTeX papers and theses. It checks the build, the PDF, the references, accessibility and venue rules, for people and for coding agents.</p>
          </div>
          <div>
            <h2>Pages</h2>
            <ul>
              <li><a href={url('docs/')}>Guide</a></li>
              <li><a href={url('rules/')}>Rule index</a></li>
              <li><a href={url('check/')}>Browser check</a></li>
              <li><a href={url('templates/')}>Templates</a></li>
            </ul>
          </div>
          <div>
            <h2>Source</h2>
            <ul>
              <li><a href={REPO_URL}>github.com/amet13/overfull</a></li>
              <li><a href={`${REPO_URL}/issues`}>Issues</a></li>
              <li><a href={`${REPO_URL}/blob/main/CHANGELOG.md`}>Changelog</a></li>
            </ul>
          </div>
          <div>
            <h2>Colophon</h2>
            <p>Set in Libertinus Serif, a descendant of Linux Libertine, with Libertinus Sans and Commit Mono. No trackers, no cookies.</p>
          </div>
        </footer>
      </div>
    </div>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = btn?.querySelector<HTMLElement>('[data-theme-label]');
      const root = document.documentElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (media.matches ? 'dark' : 'light');
      const sync = () => {
        const dark = current() === 'dark';
        if (label) label.textContent = dark ? 'Light' : 'Dark';
        btn?.setAttribute('aria-pressed', String(dark));
        btn?.setAttribute('title', dark ? 'Switch to the light (paper) theme' : 'Switch to the dark (lightbox) theme');
      };
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('overfull-theme', next);
        } catch {
          /* storage unavailable: theme lasts for this page only */
        }
        sync();
      });
      media.addEventListener('change', sync);
      sync();
    </script>
  </body>
</html>
