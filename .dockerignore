# Build context for docker/Dockerfile is the repository root.
# Keep it small: only sources needed to build the overfull CLI.
.git/
**/node_modules/
**/dist/
!action/dist/
**/.astro/
coverage/
dist-standalone/
out/
assets/
**/.overfull/
*.tsbuildinfo

# LaTeX outputs anywhere in the tree (templates, corpus)
**/*.pdf
**/*.aux
**/*.log
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.bbl
**/*.bcf
**/*.blg
**/*.run.xml
**/*.toc
**/*.out

# Editor / OS
.vscode/
.DS_Store
*.swp
*~
