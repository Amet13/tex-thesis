{
  "name": "overfull-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter @overfull/core build && pnpm --filter overfull build && pnpm --filter overfull-action build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . && markdownlint-cli2 && node scripts/check-portable-paths.mjs",
    "fmt": "biome check --write .",
    "corpus:capture": "node scripts/corpus.mjs --capture",
    "corpus:verify": "node scripts/corpus.mjs --verify",
    "templates:sync": "node scripts/sync-templates.mjs",
    "templates:check": "node scripts/sync-templates.mjs --check",
    "standalone": "node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "markdownlint-cli2": "0.24.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
